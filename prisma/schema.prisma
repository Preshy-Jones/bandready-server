// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  passwordHash          String?   @map("password_hash")
  fullName              String?   @map("full_name")
  googleId              String?   @unique @map("google_id")
  avatarUrl             String?   @map("avatar_url")
  targetBandScore       Decimal   @default(7.0) @map("target_band_score") @db.Decimal(2, 1)
  targetExamDate        DateTime? @map("target_exam_date")
  nativeLanguage        String?   @map("native_language")
  country               String?
  examType              ExamType  @default(ACADEMIC) @map("exam_type")
  subscriptionTier      String    @default("free") @map("subscription_tier")
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")
  paystackCustomerCode  String?   @map("paystack_customer_code")
  paddleCustomerId      String?   @map("paddle_customer_id")
  paddleSubscriptionId  String?   @map("paddle_subscription_id")
  isEmailVerified       Boolean   @default(false) @map("is_email_verified")
  emailVerificationOtp  String?   @map("email_verification_otp")
  emailVerificationOtpExpiry DateTime? @map("email_verification_otp_expiry")
  speakingBalance       Int       @default(0) @map("speaking_balance")
  writingBalance        Int       @default(0) @map("writing_balance")
  dailySpeakingUsed     Int       @default(0) @map("daily_speaking_used")
  dailySessionsResetAt  DateTime  @default(now()) @map("daily_sessions_reset_at")
  role                  Role      @default(USER)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  practiceSessions PracticeSession[]
  progress         UserProgress?
  mockTests        MockTest[]

  // Writing module relations
  essaySubmissions    EssaySubmission[]
  writingWeaknesses   WritingWeakness[]
  drillAttempts       DrillAttempt[]
  writingProgress     WritingProgress?
  paymentTransactions PaymentTransaction[]

  @@map("users")
}

model PaymentTransaction {
  id                   String        @id @default(uuid())
  userId               String        @map("user_id")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String        @default("paystack") // "paystack" or "paddle"
  plan                 String
  amountKobo           Int           @default(0) @map("amount_kobo") // For NGN (Paystack)
  amountCents          Int           @default(0) @map("amount_cents") // For USD (Paddle)
  currency             String        @default("NGN")
  reference            String        @unique
  paddleTransactionId  String?       @unique @map("paddle_transaction_id")
  status               PaymentStatus @default(PENDING)
  paidAt               DateTime?     @map("paid_at")
  subscriptionStartsAt DateTime?     @map("subscription_starts_at")
  subscriptionEndsAt   DateTime?     @map("subscription_ends_at")
  metadata             Json?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("payment_transactions")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model SpeakingQuestion {
  id                String   @id @default(uuid())
  part              Int
  topic             String   @db.VarChar(100)
  questionText      String   @map("question_text")
  cueCardPoints     Json?    @map("cue_card_points")
  relatedPart2Topic String?  @map("related_part2_topic") @db.VarChar(100)
  difficultyLevel   String   @default("medium") @map("difficulty_level") @db.VarChar(20)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  practiceSessions PracticeSession[]

  @@index([part, topic])
  @@map("speaking_questions")
}

model PracticeSession {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  questionId String @map("question_id")
  part       Int

  // Audio data
  audioUrl             String?  @map("audio_url")
  audioDurationSeconds Decimal? @map("audio_duration_seconds") @db.Decimal(6, 2)

  // Transcription
  transcript               String?
  transcriptWithTimestamps Json?   @map("transcript_with_timestamps")

  // AI Analysis Results
  overallBandScore      Decimal? @map("overall_band_score") @db.Decimal(2, 1)
  fluencyCoherenceScore Decimal? @map("fluency_coherence_score") @db.Decimal(2, 1)
  lexicalResourceScore  Decimal? @map("lexical_resource_score") @db.Decimal(2, 1)
  grammarAccuracyScore  Decimal? @map("grammar_accuracy_score") @db.Decimal(2, 1)
  pronunciationScore    Decimal? @map("pronunciation_score") @db.Decimal(2, 1)

  // Detailed metrics
  wordsPerMinute    Decimal? @map("words_per_minute") @db.Decimal(5, 2)
  totalWords        Int?     @map("total_words")
  fillerWordCount   Int?     @map("filler_word_count")
  fillerWordsDetail Json?    @map("filler_words_detail")
  pauseCount        Int?     @map("pause_count")
  longPauseCount    Int?     @map("long_pause_count")
  pauseLocations    Json?    @map("pause_locations")

  // AI Feedback
  feedbackFluency       String? @map("feedback_fluency")
  feedbackVocabulary    String? @map("feedback_vocabulary")
  feedbackGrammar       String? @map("feedback_grammar")
  feedbackPronunciation String? @map("feedback_pronunciation")
  feedbackOverall       String? @map("feedback_overall")

  // Suggestions
  vocabularySuggestions Json? @map("vocabulary_suggestions")
  grammarCorrections    Json? @map("grammar_corrections")
  mispronouncedWords    Json? @map("mispronounced_words")

  // Model answer comparison
  modelAnswer         String? @map("model_answer")
  enhancedModelAnswer Json?   @map("enhanced_model_answer")

  // Session metadata
  prepTimeUsedSeconds Int?      @map("prep_time_used_seconds")
  speakingTimeSeconds Decimal?  @map("speaking_time_seconds") @db.Decimal(6, 2)
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  // Mock test relation
  mockTestId     String? @map("mock_test_id")
  questionNumber Int?    @map("question_number")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question SpeakingQuestion @relation(fields: [questionId], references: [id])
  mockTest MockTest?        @relation(fields: [mockTestId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([part])
  @@index([overallBandScore])
  @@index([mockTestId])
  @@map("practice_sessions")
}

model UserProgress {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Rolling averages (last 10 sessions)
  avgOverallScore       Decimal? @map("avg_overall_score") @db.Decimal(3, 2)
  avgFluencyScore       Decimal? @map("avg_fluency_score") @db.Decimal(3, 2)
  avgLexicalScore       Decimal? @map("avg_lexical_score") @db.Decimal(3, 2)
  avgGrammarScore       Decimal? @map("avg_grammar_score") @db.Decimal(3, 2)
  avgPronunciationScore Decimal? @map("avg_pronunciation_score") @db.Decimal(3, 2)

  // Totals
  totalSessions        Int     @default(0) @map("total_sessions")
  totalPracticeMinutes Decimal @default(0) @map("total_practice_minutes") @db.Decimal(8, 2)

  // Streaks
  currentStreakDays Int       @default(0) @map("current_streak_days")
  longestStreakDays Int       @default(0) @map("longest_streak_days")
  lastPracticeDate  DateTime? @map("last_practice_date")

  // Weak areas identified by AI
  weakAreas   Json? @map("weak_areas")
  strongAreas Json? @map("strong_areas")

  // Part-specific progress
  part1AvgScore Decimal? @map("part1_avg_score") @db.Decimal(3, 2)
  part2AvgScore Decimal? @map("part2_avg_score") @db.Decimal(3, 2)
  part3AvgScore Decimal? @map("part3_avg_score") @db.Decimal(3, 2)

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_progress")
}

model MockTest {
  id     String @id @default(uuid())
  userId String @map("user_id")

  // Configuration
  timingMode String @default("flexible") @map("timing_mode")

  // State tracking
  currentPart     Int    @default(1) @map("current_part")
  currentQuestion Int    @default(1) @map("current_question")
  status          String @default("in_progress")

  // Question sequencing
  questionSequence Json?   @map("question_sequence") // Stores pre-selected question IDs
  part2Topic       String? @map("part2_topic") @db.VarChar(100) // For linking Part 3 questions

  // Results
  overallScore      Decimal? @map("overall_score") @db.Decimal(2, 1)
  crossPartAnalysis Json?    @map("cross_part_analysis")

  // Timestamps
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions PracticeSession[]

  @@index([userId, completedAt(sort: Desc)])
  @@map("mock_tests")
}

// =============================================
// WRITING MODULE
// =============================================

// =============================================
// WRITING QUESTIONS
// =============================================
model WritingQuestion {
  id          String            @id @default(uuid())
  taskType    TaskType
  examType    ExamType          @default(ACADEMIC) @map("exam_type")
  subType     String? // For Task 1 Academic: "line_graph", "bar_chart", "pie_chart", "table", "process", "map"
  // For Task 1 General: "formal_letter", "semi_formal_letter", "informal_letter"
  // For Task 2: "opinion", "discussion", "problem_solution", "advantages_disadvantages", "two_part"
  prompt      String            @db.Text
  imageUrl    String?           @map("image_url") // For Task 1 charts/graphs
  modelEssays ModelEssay[]
  submissions EssaySubmission[]
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([taskType, subType])
  @@map("writing_questions")
}

enum TaskType {
  TASK1
  TASK2
}

enum ExamType {
  ACADEMIC
  GENERAL
}

// =============================================
// ESSAY SUBMISSIONS
// =============================================
model EssaySubmission {
  id         String          @id @default(uuid())
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String          @map("question_id")
  question   WritingQuestion @relation(fields: [questionId], references: [id])

  essayText        String @map("essay_text") @db.Text
  wordCount        Int    @map("word_count")
  timeSpentSeconds Int    @map("time_spent_seconds")

  // Scores (set after AI assessment)
  taskResponseScore      Decimal? @map("task_response_score") @db.Decimal(2, 1)
  coherenceCohesionScore Decimal? @map("coherence_cohesion_score") @db.Decimal(2, 1)
  lexicalResourceScore   Decimal? @map("lexical_resource_score") @db.Decimal(2, 1)
  grammarAccuracyScore   Decimal? @map("grammar_accuracy_score") @db.Decimal(2, 1)
  overallBandScore       Decimal? @map("overall_band_score") @db.Decimal(2, 1)

  // AI Feedback
  feedback EssayFeedback?

  // Metadata
  sessionType SessionType @default(PRACTICE) @map("session_type")
  submittedAt DateTime    @default(now()) @map("submitted_at")

  @@index([userId, submittedAt(sort: Desc)])
  @@index([overallBandScore])
  @@map("essay_submissions")
}

enum SessionType {
  DIAGNOSTIC
  PRACTICE
  DRILL
  EXAM_SIMULATION
}

// =============================================
// ESSAY FEEDBACK (AI-Generated)
// =============================================
model EssayFeedback {
  id      String          @id @default(uuid())
  essayId String          @unique @map("essay_id")
  essay   EssaySubmission @relation(fields: [essayId], references: [id], onDelete: Cascade)

  // Criterion-specific feedback
  taskResponseFeedback      String @map("task_response_feedback") @db.Text
  coherenceCohesionFeedback String @map("coherence_cohesion_feedback") @db.Text
  lexicalResourceFeedback   String @map("lexical_resource_feedback") @db.Text
  grammarAccuracyFeedback   String @map("grammar_accuracy_feedback") @db.Text
  overallFeedback           String @map("overall_feedback") @db.Text

  // Annotations (JSON array of inline highlights)
  annotations Json // Array<{startIndex, endIndex, color, type, explanation}>

  // Examiner Eye insights
  examinerInsights Json @map("examiner_insights") // Array<{sentence, issue, bandImpact}>

  // Priority improvements
  priorityFixes Json @map("priority_fixes") // Array<{issue, explanation, drillType}>

  // Detected errors (feeds into weakness profile)
  detectedErrors Json @map("detected_errors") // Array<{category, specificError, sentence, correction}>

  // Vocabulary suggestions
  vocabularySuggestions Json? @map("vocabulary_suggestions") // Array<{original, suggested, context}>

  createdAt DateTime @default(now()) @map("created_at")

  @@map("essay_feedback")
}

// =============================================
// WEAKNESS PROFILE
// =============================================
model WritingWeakness {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category      WeaknessCategory
  specificError String           @map("specific_error") // e.g., "comma_splice", "article_misuse", "weak_collocation"
  displayName   String           @map("display_name") // e.g., "Comma Splices", "Article Misuse"

  severity             Severity          @default(MEDIUM)
  frequency            Int               @default(1) // Total occurrences
  sessionsWithoutError Int               @default(0) @map("sessions_without_error") // Consecutive clean sessions
  status               ImprovementStatus @default(STAGNANT)

  lastOccurrence DateTime @default(now()) @map("last_occurrence")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, specificError])
  @@index([userId, severity])
  @@map("writing_weaknesses")
}

enum WeaknessCategory {
  GRAMMAR
  VOCABULARY
  COHERENCE
  TASK_RESPONSE
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

enum ImprovementStatus {
  IMPROVING
  STAGNANT
  WORSENING
}

// =============================================
// DRILLS
// =============================================
model WritingDrill {
  id            String           @id @default(uuid())
  type          DrillType
  category      WeaknessCategory
  specificSkill String           @map("specific_skill") // e.g., "article_correction", "collocation_upgrade"

  instruction   String @db.Text
  content       String @db.Text // The drill content (sentence to fix, options, etc.)
  correctAnswer String @map("correct_answer") @db.Text
  explanation   String @db.Text // Why this is correct

  difficulty Difficulty @default(MEDIUM)
  timeLimit  Int?       @map("time_limit") // Seconds, null = no limit

  relatedWeaknesses String[] @map("related_weaknesses") // Array of specificError values this drill addresses

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  attempts DrillAttempt[]

  @@index([type, category, difficulty])
  @@map("writing_drills")
}

enum DrillType {
  MICRO_DRILL // 5-10 min focused exercises
  TASK1_TRACK // Task 1 specific skills
  TASK2_TRACK // Task 2 specific skills
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model DrillAttempt {
  id      String       @id @default(uuid())
  userId  String       @map("user_id")
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  drillId String       @map("drill_id")
  drill   WritingDrill @relation(fields: [drillId], references: [id])

  userAnswer       String  @map("user_answer") @db.Text
  isCorrect        Boolean @map("is_correct")
  timeSpentSeconds Int?    @map("time_spent_seconds")

  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@index([userId, drillId])
  @@index([userId, attemptedAt(sort: Desc)])
  @@map("drill_attempts")
}

// =============================================
// MODEL ESSAYS
// =============================================
model ModelEssay {
  id         String          @id @default(uuid())
  questionId String          @map("question_id")
  question   WritingQuestion @relation(fields: [questionId], references: [id])

  essayText String  @map("essay_text") @db.Text
  bandScore Decimal @map("band_score") @db.Decimal(2, 1) // e.g., 8.0, 8.5

  // Highlighted elements for learning
  strongPhrases  Json @map("strong_phrases") // Array<{text, explanation}>
  structureNotes Json @map("structure_notes") // Array<{section, note}>

  createdAt DateTime @default(now()) @map("created_at")

  @@index([questionId])
  @@map("model_essays")
}

// =============================================
// WRITING PROGRESS (Aggregated Stats)
// =============================================
model WritingProgress {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rolling averages (last 10 essays)
  avgOverallScore Decimal? @map("avg_overall_score") @db.Decimal(4, 2)
  avgTaskResponse Decimal? @map("avg_task_response") @db.Decimal(4, 2)
  avgCoherence    Decimal? @map("avg_coherence") @db.Decimal(4, 2)
  avgLexical      Decimal? @map("avg_lexical") @db.Decimal(4, 2)
  avgGrammar      Decimal? @map("avg_grammar") @db.Decimal(4, 2)

  // Task-specific averages
  avgTask1Score Decimal? @map("avg_task1_score") @db.Decimal(4, 2)
  avgTask2Score Decimal? @map("avg_task2_score") @db.Decimal(4, 2)

  // Totals
  totalEssays          Int     @default(0) @map("total_essays")
  totalDrillsCompleted Int     @default(0) @map("total_drills_completed")
  totalPracticeMinutes Decimal @default(0) @map("total_practice_minutes") @db.Decimal(8, 2)

  // Milestones (JSON array of achieved milestones)
  milestones Json @default("[]")

  // Exam readiness
  examReadyTask1 Boolean @default(false) @map("exam_ready_task1")
  examReadyTask2 Boolean @default(false) @map("exam_ready_task2")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("writing_progress")
}
