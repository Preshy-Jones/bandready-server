// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

// =============================================
// B2B ENUMS
// =============================================

enum OrgType {
  TRAINING_CENTER
  LANGUAGE_SCHOOL
  CONSULTANCY
  UNIVERSITY
  CORPORATE
}

enum OrgSubscriptionTier {
  STARTER
  GROWTH
  PROFESSIONAL
  ENTERPRISE
}

enum OrgSubscriptionStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum OrgAdminRole {
  OWNER
  ADMIN
  MANAGER
  TUTOR
}

enum CohortStudentStatus {
  COHORT_ACTIVE
  COMPLETED
  DROPPED
}

enum AssignmentPracticeType {
  SPEAKING
  WRITING
  READING
  LISTENING
  MIXED
}

enum InvoiceStatus {
  INVOICE_PENDING
  PAID
  OVERDUE
  INVOICE_CANCELLED
}

enum ActivityActorType {
  ACTIVITY_ADMIN
  ACTIVITY_STUDENT
  SYSTEM
}

model User {
  id                         String    @id @default(uuid())
  email                      String    @unique
  passwordHash               String?   @map("password_hash")
  fullName                   String?   @map("full_name")
  googleId                   String?   @unique @map("google_id")
  avatarUrl                  String?   @map("avatar_url")
  targetBandScore            Decimal   @default(7.0) @map("target_band_score") @db.Decimal(2, 1)
  targetExamDate             DateTime? @map("target_exam_date")
  nativeLanguage             String?   @map("native_language")
  country                    String?
  examType                   ExamType  @default(ACADEMIC) @map("exam_type")
  subscriptionTier           String    @default("none") @map("subscription_tier")
  subscriptionExpiresAt      DateTime? @map("subscription_expires_at")
  paystackCustomerCode       String?   @map("paystack_customer_code")
  paddleCustomerId           String?   @map("paddle_customer_id")
  paddleSubscriptionId       String?   @map("paddle_subscription_id")
  polarCustomerId            String?   @map("polar_customer_id")
  isEmailVerified            Boolean   @default(false) @map("is_email_verified")
  emailVerificationOtp       String?   @map("email_verification_otp")
  emailVerificationOtpExpiry DateTime? @map("email_verification_otp_expiry")
  passwordResetTokenHash     String?   @map("password_reset_token_hash")
  passwordResetTokenExpiry   DateTime? @map("password_reset_token_expiry")
  speakingBalance            Int       @default(0) @map("speaking_balance")
  writingBalance             Int       @default(0) @map("writing_balance")
  creditBalance              Int       @default(0) @map("credit_balance")
  drillsExpireAt             DateTime? @map("drills_expire_at")
  role                       Role      @default(USER)
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")

  // B2B fields
  organizationId    String?   @map("organization_id")
  studentId         String?   @map("student_id") @db.VarChar(100)
  enrolledAt        DateTime? @map("enrolled_at")
  assignedTutorId   String?   @map("assigned_tutor_id")

  practiceSessions PracticeSession[]
  progress         UserProgress?
  mockTests        MockTest[]

  // Writing module relations
  essaySubmissions    EssaySubmission[]
  writingWeaknesses   WritingWeakness[]
  drillAttempts       DrillAttempt[]
  writingProgress     WritingProgress?
  paymentTransactions PaymentTransaction[]
  drillReviewQueues   DrillReviewQueue[]
  readingSessions     ReadingSession[]
  readingProgress     ReadingProgress[]
  readingAchievements ReadingAchievement[]

  // B2B relations
  organization          Organization?       @relation(fields: [organizationId], references: [id])
  assignedTutor         OrganizationAdmin?  @relation("TutorStudents", fields: [assignedTutorId], references: [id])
  organizationAdmins    OrganizationAdmin[]
  cohortMemberships     CohortStudent[]
  practiceAssignments   PracticeAssignment[]
  assignmentCompletions AssignmentCompletion[]

  @@index([organizationId])
  @@map("users")
}

model PaymentTransaction {
  id                   String        @id @default(uuid())
  userId               String        @map("user_id")
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String        @default("paystack") // "paystack", "paddle", or "polar"
  plan                 String
  amountKobo           Int           @default(0) @map("amount_kobo") // For NGN (Paystack)
  amountCents          Int           @default(0) @map("amount_cents") // For USD (Paddle)
  currency             String        @default("NGN")
  reference            String        @unique
  paddleTransactionId  String?       @unique @map("paddle_transaction_id")
  polarCheckoutId      String?       @unique @map("polar_checkout_id")
  status               PaymentStatus @default(PENDING)
  paidAt               DateTime?     @map("paid_at")
  subscriptionStartsAt DateTime?     @map("subscription_starts_at")
  subscriptionEndsAt   DateTime?     @map("subscription_ends_at")
  metadata             Json?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@map("payment_transactions")
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model SpeakingQuestion {
  id                String   @id @default(uuid())
  part              Int
  topic             String   @db.VarChar(100)
  questionText      String   @map("question_text")
  cueCardPoints     Json?    @map("cue_card_points")
  relatedPart2Topic String?  @map("related_part2_topic") @db.VarChar(100)
  difficultyLevel   String   @default("medium") @map("difficulty_level") @db.VarChar(20)
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  practiceSessions PracticeSession[]

  @@index([part, topic])
  @@map("speaking_questions")
}

model PracticeSession {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  questionId String @map("question_id")
  part       Int

  // Audio data
  audioUrl             String?  @map("audio_url")
  audioDurationSeconds Decimal? @map("audio_duration_seconds") @db.Decimal(6, 2)

  // Transcription
  transcript               String?
  transcriptWithTimestamps Json?   @map("transcript_with_timestamps")

  // AI Analysis Results
  overallBandScore      Decimal? @map("overall_band_score") @db.Decimal(2, 1)
  fluencyCoherenceScore Decimal? @map("fluency_coherence_score") @db.Decimal(2, 1)
  lexicalResourceScore  Decimal? @map("lexical_resource_score") @db.Decimal(2, 1)
  grammarAccuracyScore  Decimal? @map("grammar_accuracy_score") @db.Decimal(2, 1)
  pronunciationScore    Decimal? @map("pronunciation_score") @db.Decimal(2, 1)

  // Detailed metrics
  wordsPerMinute    Decimal? @map("words_per_minute") @db.Decimal(5, 2)
  totalWords        Int?     @map("total_words")
  fillerWordCount   Int?     @map("filler_word_count")
  fillerWordsDetail Json?    @map("filler_words_detail")
  pauseCount        Int?     @map("pause_count")
  longPauseCount    Int?     @map("long_pause_count")
  pauseLocations    Json?    @map("pause_locations")

  // AI Feedback
  feedbackFluency       String? @map("feedback_fluency")
  feedbackVocabulary    String? @map("feedback_vocabulary")
  feedbackGrammar       String? @map("feedback_grammar")
  feedbackPronunciation String? @map("feedback_pronunciation")
  feedbackOverall       String? @map("feedback_overall")

  // Suggestions
  vocabularySuggestions Json? @map("vocabulary_suggestions")
  grammarCorrections    Json? @map("grammar_corrections")
  mispronouncedWords    Json? @map("mispronounced_words")

  // Model answer comparison
  modelAnswer         String? @map("model_answer")
  enhancedModelAnswer Json?   @map("enhanced_model_answer")

  // Session metadata
  sessionType         SessionType @default(PRACTICE) @map("session_type")
  prepTimeUsedSeconds Int?      @map("prep_time_used_seconds")
  speakingTimeSeconds Decimal?  @map("speaking_time_seconds") @db.Decimal(6, 2)
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  // Mock test relation
  mockTestId     String? @map("mock_test_id")
  questionNumber Int?    @map("question_number")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  question SpeakingQuestion @relation(fields: [questionId], references: [id])
  mockTest MockTest?        @relation(fields: [mockTestId], references: [id])

  @@index([userId, createdAt(sort: Desc)])
  @@index([part])
  @@index([overallBandScore])
  @@index([mockTestId])
  @@map("practice_sessions")
}

model UserProgress {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  // Rolling averages (last 10 sessions)
  avgOverallScore       Decimal? @map("avg_overall_score") @db.Decimal(3, 2)
  avgFluencyScore       Decimal? @map("avg_fluency_score") @db.Decimal(3, 2)
  avgLexicalScore       Decimal? @map("avg_lexical_score") @db.Decimal(3, 2)
  avgGrammarScore       Decimal? @map("avg_grammar_score") @db.Decimal(3, 2)
  avgPronunciationScore Decimal? @map("avg_pronunciation_score") @db.Decimal(3, 2)

  // Totals
  totalSessions        Int     @default(0) @map("total_sessions")
  totalPracticeMinutes Decimal @default(0) @map("total_practice_minutes") @db.Decimal(8, 2)

  // Streaks
  currentStreakDays Int       @default(0) @map("current_streak_days")
  longestStreakDays Int       @default(0) @map("longest_streak_days")
  lastPracticeDate  DateTime? @map("last_practice_date")

  // Weak areas identified by AI
  weakAreas   Json? @map("weak_areas")
  strongAreas Json? @map("strong_areas")

  // Part-specific progress
  part1AvgScore Decimal? @map("part1_avg_score") @db.Decimal(3, 2)
  part2AvgScore Decimal? @map("part2_avg_score") @db.Decimal(3, 2)
  part3AvgScore Decimal? @map("part3_avg_score") @db.Decimal(3, 2)

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_progress")
}

model MockTest {
  id     String @id @default(uuid())
  userId String @map("user_id")

  // Configuration
  timingMode String @default("flexible") @map("timing_mode")

  // State tracking
  currentPart     Int    @default(1) @map("current_part")
  currentQuestion Int    @default(1) @map("current_question")
  status          String @default("in_progress")

  // Question sequencing
  questionSequence Json?   @map("question_sequence") // Stores pre-selected question IDs
  part2Topic       String? @map("part2_topic") @db.VarChar(100) // For linking Part 3 questions

  // Results
  overallScore      Decimal? @map("overall_score") @db.Decimal(2, 1)
  crossPartAnalysis Json?    @map("cross_part_analysis")

  // Timestamps
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Relations
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions PracticeSession[]

  @@index([userId, completedAt(sort: Desc)])
  @@map("mock_tests")
}

// =============================================
// WAITLIST
// =============================================
model Waitlist {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlists")
}

// =============================================
// WRITING MODULE
// =============================================

// =============================================
// WRITING QUESTIONS
// =============================================
model WritingQuestion {
  id          String            @id @default(uuid())
  taskType    TaskType
  examType    ExamType          @default(ACADEMIC) @map("exam_type")
  subType     String? // For Task 1 Academic: "line_graph", "bar_chart", "pie_chart", "table", "process", "map"
  // For Task 1 General: "formal_letter", "semi_formal_letter", "informal_letter"
  // For Task 2: "opinion", "discussion", "problem_solution", "advantages_disadvantages", "two_part"
  prompt      String            @db.Text
  imageUrl    String?           @map("image_url") // For Task 1 charts/graphs
  modelEssays ModelEssay[]
  submissions EssaySubmission[]
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([taskType, subType])
  @@map("writing_questions")
}

enum TaskType {
  TASK1
  TASK2
}

enum ExamType {
  ACADEMIC
  GENERAL
}

// =============================================
// ESSAY SUBMISSIONS
// =============================================
model EssaySubmission {
  id         String          @id @default(uuid())
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String          @map("question_id")
  question   WritingQuestion @relation(fields: [questionId], references: [id])

  essayText        String @map("essay_text") @db.Text
  wordCount        Int    @map("word_count")
  timeSpentSeconds Int    @map("time_spent_seconds")

  // Scores (set after AI assessment)
  taskResponseScore      Decimal? @map("task_response_score") @db.Decimal(2, 1)
  coherenceCohesionScore Decimal? @map("coherence_cohesion_score") @db.Decimal(2, 1)
  lexicalResourceScore   Decimal? @map("lexical_resource_score") @db.Decimal(2, 1)
  grammarAccuracyScore   Decimal? @map("grammar_accuracy_score") @db.Decimal(2, 1)
  overallBandScore       Decimal? @map("overall_band_score") @db.Decimal(2, 1)

  // AI Feedback
  feedback EssayFeedback?

  // Metadata
  sessionType SessionType @default(PRACTICE) @map("session_type")
  submittedAt DateTime    @default(now()) @map("submitted_at")

  @@index([userId, submittedAt(sort: Desc)])
  @@index([overallBandScore])
  @@map("essay_submissions")
}

enum SessionType {
  DIAGNOSTIC
  PRACTICE
  DRILL
  EXAM_SIMULATION
}

// =============================================
// ESSAY FEEDBACK (AI-Generated)
// =============================================
model EssayFeedback {
  id      String          @id @default(uuid())
  essayId String          @unique @map("essay_id")
  essay   EssaySubmission @relation(fields: [essayId], references: [id], onDelete: Cascade)

  // Criterion-specific feedback
  taskResponseFeedback      String @map("task_response_feedback") @db.Text
  coherenceCohesionFeedback String @map("coherence_cohesion_feedback") @db.Text
  lexicalResourceFeedback   String @map("lexical_resource_feedback") @db.Text
  grammarAccuracyFeedback   String @map("grammar_accuracy_feedback") @db.Text
  overallFeedback           String @map("overall_feedback") @db.Text

  // Annotations (JSON array of inline highlights)
  annotations Json // Array<{startIndex, endIndex, color, type, explanation}>

  // Examiner Eye insights
  examinerInsights Json @map("examiner_insights") // Array<{sentence, issue, bandImpact}>

  // Priority improvements
  priorityFixes Json @map("priority_fixes") // Array<{issue, explanation, drillType}>

  // Detected errors (feeds into weakness profile)
  detectedErrors Json @map("detected_errors") // Array<{category, specificError, sentence, correction}>

  // Vocabulary suggestions
  vocabularySuggestions Json? @map("vocabulary_suggestions") // Array<{original, suggested, context}>

  createdAt DateTime @default(now()) @map("created_at")

  @@map("essay_feedback")
}

// =============================================
// WEAKNESS PROFILE
// =============================================
model WritingWeakness {
  id     String @id @default(uuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  category      WeaknessCategory
  specificError String           @map("specific_error") // e.g., "comma_splice", "article_misuse", "weak_collocation"
  displayName   String           @map("display_name") // e.g., "Comma Splices", "Article Misuse"

  severity             Severity          @default(MEDIUM)
  frequency            Int               @default(1) // Total occurrences
  sessionsWithoutError Int               @default(0) @map("sessions_without_error") // Consecutive clean sessions
  status               ImprovementStatus @default(STAGNANT)

  lastOccurrence DateTime @default(now()) @map("last_occurrence")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([userId, specificError])
  @@index([userId, severity])
  @@map("writing_weaknesses")
}

enum WeaknessCategory {
  GRAMMAR
  VOCABULARY
  COHERENCE
  TASK_RESPONSE
}

enum Severity {
  HIGH
  MEDIUM
  LOW
}

enum ImprovementStatus {
  IMPROVING
  STAGNANT
  WORSENING
}

// =============================================
// DRILLS
// =============================================
model WritingDrill {
  id            String           @id @default(uuid())
  type          DrillType
  category      WeaknessCategory
  specificSkill String           @map("specific_skill") // e.g., "article_correction", "collocation_upgrade"

  instruction   String @db.Text
  content       String @db.Text // The drill content (sentence to fix, options, etc.)
  correctAnswer String @map("correct_answer") @db.Text
  explanation   String @db.Text // Why this is correct

  difficulty Difficulty @default(MEDIUM)
  timeLimit  Int?       @map("time_limit") // Seconds, null = no limit

  relatedWeaknesses String[] @map("related_weaknesses") // Array of specific skill/error names

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  attempts      DrillAttempt[]
  reviewQueues  DrillReviewQueue[]

  @@index([type, category, difficulty])
  @@map("writing_drills")
}

enum DrillType {
  MICRO_DRILL // 5-10 min focused exercises
  TASK1_TRACK // Task 1 specific skills
  TASK2_TRACK // Task 2 specific skills
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model DrillAttempt {
  id      String       @id @default(uuid())
  userId  String       @map("user_id")
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  drillId String       @map("drill_id")
  drill   WritingDrill @relation(fields: [drillId], references: [id])

  userAnswer       String  @map("user_answer") @db.Text
  isCorrect        Boolean @map("is_correct")
  timeSpentSeconds Int?    @map("time_spent_seconds")

  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@index([userId, drillId])
  @@index([userId, attemptedAt(sort: Desc)])
  @@map("drill_attempts")
}

model DrillReviewQueue {
  id      String       @id @default(uuid())
  userId  String       @map("user_id")
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  drillId String       @map("drill_id")
  drill   WritingDrill @relation(fields: [drillId], references: [id], onDelete: Cascade)

  nextReviewAt  DateTime @map("next_review_at")
  intervalDays  Float    @default(1.0) @map("interval_days")
  easeFactor    Float    @default(2.5) @map("ease_factor")
  consecutiveCorrect Int @default(0) @map("consecutive_correct")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, drillId])
  @@index([userId, nextReviewAt])
  @@map("drill_review_queue")
}

// =============================================
// MODEL ESSAYS
// =============================================
model ModelEssay {
  id         String          @id @default(uuid())
  questionId String          @map("question_id")
  question   WritingQuestion @relation(fields: [questionId], references: [id])

  essayText String  @map("essay_text") @db.Text
  bandScore Decimal @map("band_score") @db.Decimal(2, 1) // e.g., 8.0, 8.5

  // Highlighted elements for learning
  strongPhrases  Json @map("strong_phrases") // Array<{text, explanation}>
  structureNotes Json @map("structure_notes") // Array<{section, note}>

  createdAt DateTime @default(now()) @map("created_at")

  @@index([questionId])
  @@map("model_essays")
}

// =============================================
// WRITING PROGRESS (Aggregated Stats)
// =============================================
model WritingProgress {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Rolling averages (last 10 essays)
  avgOverallScore Decimal? @map("avg_overall_score") @db.Decimal(4, 2)
  avgTaskResponse Decimal? @map("avg_task_response") @db.Decimal(4, 2)
  avgCoherence    Decimal? @map("avg_coherence") @db.Decimal(4, 2)
  avgLexical      Decimal? @map("avg_lexical") @db.Decimal(4, 2)
  avgGrammar      Decimal? @map("avg_grammar") @db.Decimal(4, 2)

  // Task-specific averages
  avgTask1Score Decimal? @map("avg_task1_score") @db.Decimal(4, 2)
  avgTask2Score Decimal? @map("avg_task2_score") @db.Decimal(4, 2)

  // Totals
  totalEssays          Int     @default(0) @map("total_essays")
  totalDrillsCompleted Int     @default(0) @map("total_drills_completed")
  totalPracticeMinutes Decimal @default(0) @map("total_practice_minutes") @db.Decimal(8, 2)

  // Milestones (JSON array of achieved milestones)
  milestones Json @default("[]")

  // Exam readiness
  examReadyTask1 Boolean @default(false) @map("exam_ready_task1")
  examReadyTask2 Boolean @default(false) @map("exam_ready_task2")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("writing_progress")
}

// =============================================
// APP SETTINGS (Admin-configurable)
// =============================================
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// =============================================
// READING MODULE
// =============================================

enum ReadingDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ReadingTestType {
  ACADEMIC
  GENERAL_TRAINING
}

enum ReadingSessionMode {
  FULL_TEST
  SINGLE_PASSAGE
  QUESTION_TYPE_PRACTICE
  REVIEW
}

enum ReadingQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE_NOT_GIVEN
  YES_NO_NOT_GIVEN
  MATCHING_HEADINGS
  MATCHING_INFORMATION
  MATCHING_FEATURES
  MATCHING_SENTENCE_ENDINGS
  SENTENCE_COMPLETION
  SUMMARY_COMPLETION
  SHORT_ANSWER
  DIAGRAM_LABEL
}

model ReadingPassage {
  id                String            @id @default(uuid())
  title             String            @db.VarChar(255)
  content           String            @db.Text
  wordCount         Int               @map("word_count")
  difficultyLevel   ReadingDifficulty @map("difficulty_level")
  testType          ReadingTestType   @map("test_type")
  topicCategory     String            @map("topic_category") @db.VarChar(100)
  sourceAttribution String?           @map("source_attribution") @db.Text
  vocabularyTerms   Json?             @map("vocabulary_terms")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  paragraphs   PassageParagraph[]
  questions    ReadingQuestion[]
  questionSets ReadingQuestionSet[]
  sessionItems ReadingSessionPassage[]

  @@index([difficultyLevel])
  @@index([testType])
  @@index([topicCategory])
  @@map("reading_passages")
}

model PassageParagraph {
  id             String         @id @default(uuid())
  passageId      String         @map("passage_id")
  passage        ReadingPassage @relation(fields: [passageId], references: [id], onDelete: Cascade)
  paragraphIndex Int            @map("paragraph_index")
  label          String         @db.VarChar(5)
  content        String         @db.Text

  @@unique([passageId, paragraphIndex])
  @@unique([passageId, label])
  @@map("passage_paragraphs")
}

model ReadingQuestionSet {
  id                 String              @id @default(uuid())
  passageId          String              @map("passage_id")
  passage            ReadingPassage      @relation(fields: [passageId], references: [id], onDelete: Cascade)
  questionType       ReadingQuestionType @map("question_type")
  instructions       String              @db.Text
  questionRangeStart Int                 @map("question_range_start")
  questionRangeEnd   Int                 @map("question_range_end")
  setData            Json?               @map("set_data")
  createdAt          DateTime            @default(now()) @map("created_at")

  questions ReadingQuestion[]

  @@index([passageId, questionType])
  @@map("reading_question_sets")
}

model ReadingQuestion {
  id             String              @id @default(uuid())
  passageId      String              @map("passage_id")
  passage        ReadingPassage      @relation(fields: [passageId], references: [id], onDelete: Cascade)
  questionSetId  String?             @map("question_set_id")
  questionSet    ReadingQuestionSet? @relation(fields: [questionSetId], references: [id], onDelete: SetNull)
  questionType   ReadingQuestionType @map("question_type")
  questionNumber Int                 @map("question_number")
  questionData   Json                @map("question_data")
  correctAnswer  Json                @map("correct_answer")
  explanation    String?             @db.Text
  skillTested    String?             @map("skill_tested") @db.VarChar(100)
  createdAt      DateTime            @default(now()) @map("created_at")

  answers ReadingAnswer[]

  @@unique([passageId, questionNumber])
  @@index([passageId])
  @@index([questionType])
  @@map("reading_questions")
}

model ReadingSession {
  id               String             @id @default(uuid())
  userId           String             @map("user_id")
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  testType         ReadingTestType    @map("test_type")
  mode             ReadingSessionMode
  isTimed          Boolean            @default(true) @map("is_timed")
  startedAt        DateTime           @default(now()) @map("started_at")
  completedAt      DateTime?          @map("completed_at")
  timeSpentSeconds Int?               @map("time_spent_seconds")
  practiceFilters  Json?              @map("practice_filters")
  createdAt        DateTime           @default(now()) @map("created_at")

  passages ReadingSessionPassage[]
  answers  ReadingAnswer[]
  results  ReadingResult[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([completedAt])
  @@map("reading_sessions")
}

model ReadingSessionPassage {
  id               String         @id @default(uuid())
  sessionId        String         @map("session_id")
  session          ReadingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  passageId        String         @map("passage_id")
  passage          ReadingPassage @relation(fields: [passageId], references: [id])
  passageOrder     Int            @map("passage_order")
  timeSpentSeconds Int?           @map("time_spent_seconds")

  @@unique([sessionId, passageOrder])
  @@index([passageId])
  @@map("reading_session_passages")
}

model ReadingAnswer {
  id               String          @id @default(uuid())
  sessionId        String          @map("session_id")
  session          ReadingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId       String          @map("question_id")
  question         ReadingQuestion @relation(fields: [questionId], references: [id])
  userAnswer       Json            @map("user_answer")
  isCorrect        Boolean         @map("is_correct")
  timeSpentSeconds Int?            @map("time_spent_seconds")
  answeredAt       DateTime        @default(now()) @map("answered_at")

  @@unique([sessionId, questionId])
  @@index([sessionId])
  @@map("reading_answers")
}

model ReadingResult {
  id                    String         @id @default(uuid())
  sessionId             String         @map("session_id")
  session               ReadingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rawScore              Int            @map("raw_score")
  totalQuestions        Int            @map("total_questions")
  bandScore             Decimal        @map("band_score") @db.Decimal(3, 1)
  questionTypeBreakdown Json?          @map("question_type_breakdown")
  skillBreakdown        Json?          @map("skill_breakdown")
  timeManagement        Json?          @map("time_management")
  aiAnalysis            Json?          @map("ai_analysis")
  completionReason      String?        @map("completion_reason")
  createdAt             DateTime       @default(now()) @map("created_at")

  @@index([sessionId])
  @@map("reading_results")
}

model ReadingProgress {
  id              String              @id @default(uuid())
  userId          String              @map("user_id")
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionType    ReadingQuestionType @map("question_type")
  attempts        Int                 @default(0)
  correct         Int                 @default(0)
  accuracyRate    Decimal?            @map("accuracy_rate") @db.Decimal(5, 2)
  lastPracticedAt DateTime?           @map("last_practiced_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@unique([userId, questionType])
  @@index([userId])
  @@map("reading_progress")
}

model ReadingAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("reading_achievements")
}

// =============================================
// B2B ORGANIZATIONS
// =============================================

model Organization {
  id    String  @id @default(uuid())
  name  String  @db.VarChar(255)
  slug  String  @unique @db.VarChar(100)
  type  OrgType

  // Contact
  email   String  @db.VarChar(255)
  phone   String? @db.VarChar(50)
  address String?
  city    String? @db.VarChar(100)
  country String  @default("Nigeria") @db.VarChar(100)

  // Subscription
  subscriptionTier     OrgSubscriptionTier   @default(STARTER) @map("subscription_tier")
  subscriptionStatus   OrgSubscriptionStatus @default(TRIAL) @map("subscription_status")
  maxStudents          Int                   @default(30) @map("max_students")
  trialEndsAt          DateTime?             @map("trial_ends_at")
  subscriptionStartsAt DateTime?             @map("subscription_starts_at")
  subscriptionEndsAt   DateTime?             @map("subscription_ends_at")

  // Billing
  billingEmail String?      @map("billing_email") @db.VarChar(255)
  billingCycle BillingCycle  @default(MONTHLY) @map("billing_cycle")
  currency     String       @default("NGN") @db.VarChar(10)

  // Branding
  logoUrl      String? @map("logo_url") @db.VarChar(500)
  primaryColor String  @default("#4F46E5") @map("primary_color") @db.VarChar(10)
  customDomain String? @map("custom_domain") @db.VarChar(255)

  // Metadata
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  admins       OrganizationAdmin[]
  students     User[]
  cohorts      Cohort[]
  assignments  PracticeAssignment[]
  invoices     OrganizationInvoice[]
  activityLogs OrganizationActivityLog[]

  @@map("organizations")
}

model OrganizationAdmin {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  role           OrgAdminRole
  permissions    Json         @default("{}")
  invitedById    String?      @map("invited_by")
  invitedAt      DateTime     @default(now()) @map("invited_at")
  acceptedAt     DateTime?    @map("accepted_at")
  isActive       Boolean      @default(true) @map("is_active")

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy        OrganizationAdmin?  @relation("AdminInvitations", fields: [invitedById], references: [id])
  invitations      OrganizationAdmin[] @relation("AdminInvitations")
  assignedCohorts  Cohort[]
  assignedStudents User[]              @relation("TutorStudents")
  assignments      PracticeAssignment[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@map("organization_admins")
}

model Cohort {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  name            String   @db.VarChar(255)
  description     String?
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  targetExamDate  DateTime? @map("target_exam_date") @db.Date
  targetBandScore Decimal?  @map("target_band_score") @db.Decimal(2, 1)
  assignedTutorId String?   @map("assigned_tutor_id")
  maxStudents     Int?      @map("max_students")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTutor OrganizationAdmin? @relation(fields: [assignedTutorId], references: [id])
  students      CohortStudent[]
  assignments   PracticeAssignment[]

  @@index([organizationId])
  @@map("cohorts")
}

model CohortStudent {
  id         String              @id @default(uuid())
  cohortId   String              @map("cohort_id")
  userId     String              @map("user_id")
  enrolledAt DateTime            @default(now()) @map("enrolled_at")
  status     CohortStudentStatus @default(COHORT_ACTIVE)

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([userId])
  @@map("cohort_students")
}

model PracticeAssignment {
  id             String                 @id @default(uuid())
  organizationId String                 @map("organization_id")
  assignedById   String                 @map("assigned_by")
  cohortId       String?                @map("cohort_id")
  userId         String?                @map("user_id")
  title          String                 @db.VarChar(255)
  description    String?
  practiceType   AssignmentPracticeType  @map("practice_type")
  minSessions    Int                    @default(1) @map("min_sessions")
  specificParts  Json?                  @map("specific_parts")
  dueDate        DateTime?              @map("due_date")
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedBy   OrganizationAdmin @relation(fields: [assignedById], references: [id])
  cohort       Cohort?           @relation(fields: [cohortId], references: [id])
  targetUser   User?             @relation(fields: [userId], references: [id])
  completions  AssignmentCompletion[]

  @@index([organizationId])
  @@map("practice_assignments")
}

model AssignmentCompletion {
  id                String    @id @default(uuid())
  assignmentId      String    @map("assignment_id")
  userId            String    @map("user_id")
  sessionsCompleted Int       @default(0) @map("sessions_completed")
  averageScore      Decimal?  @map("average_score") @db.Decimal(3, 1)
  completedAt       DateTime? @map("completed_at")

  assignment PracticeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@map("assignment_completions")
}

model OrganizationInvoice {
  id               String        @id @default(uuid())
  organizationId   String        @map("organization_id")
  invoiceNumber    String        @unique @map("invoice_number") @db.VarChar(100)
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @default("NGN") @db.VarChar(10)
  status           InvoiceStatus @default(INVOICE_PENDING)
  periodStart      DateTime      @map("period_start") @db.Date
  periodEnd        DateTime      @map("period_end") @db.Date
  dueDate          DateTime      @map("due_date") @db.Date
  paidAt           DateTime?     @map("paid_at")
  paymentReference String?       @map("payment_reference") @db.VarChar(255)
  pdfUrl           String?       @map("pdf_url") @db.VarChar(500)
  createdAt        DateTime      @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_invoices")
}

model OrganizationActivityLog {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  actorId        String?            @map("actor_id")
  actorType      ActivityActorType? @map("actor_type")
  action         String             @db.VarChar(100)
  entityType     String?            @map("entity_type") @db.VarChar(100)
  entityId       String?            @map("entity_id")
  details        Json?
  ipAddress      String?            @map("ip_address") @db.VarChar(50)
  createdAt      DateTime           @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("organization_activity_logs")
}
