# Environment Variables
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ielts_speaking?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# Frontend URL (for redirects after OAuth)
FRONTEND_URL="http://localhost:3000"

# External APIs
OPENAI_API_KEY="your-openai-api-key"
RESEND_API_KEY="your-resend-api-key"

# Sentry
SENTRY_DSN=""

# S3/R2 Storage
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="auto"
AWS_S3_BUCKET="ielts-audio-recordings"
AWS_S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"

# Paystack
PAYSTACK_SECRET_KEY="sk_test_your-paystack-secret-key"
PAYSTACK_PUBLIC_KEY="pk_test_your-paystack-public-key"

REDIS_URL="redis://localhost:6379"

RESEND_API_KEY=resend_api_key
MAIL_FROM='domain@domain.com'

# Paddle
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=
PADDLE_MONTHLY_PRICE_ID=
PADDLE_YEARLY_PRICE_ID=
PADDLE_SA_MONTHLY_PRICE_ID=
PADDLE_SA_YEARLY_PRICE_ID=

# Polar
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Polar product IDs (one per pack tier + plan)
POLAR_PRODUCT_INDIA_STARTER=
POLAR_PRODUCT_INDIA_STANDARD=
POLAR_PRODUCT_INDIA_PRO=
POLAR_PRODUCT_INDIA_ULTIMATE=
POLAR_PRODUCT_ROW_STARTER=
POLAR_PRODUCT_ROW_STANDARD=
POLAR_PRODUCT_ROW_PRO=
POLAR_PRODUCT_ROW_ULTIMATE=